{
  "name": "@tn3270/gui",
  "version": "0.1.0",
  "description": "An Electron TN3270 emulator with a canvas renderer that blits glyphs from an atlas baked out of x3270's own 3270 bitmap font.",
  "license": "MIT",
  "author": "Adam Thornton <athornton@gmail.com>",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "tn3270-gui": "./bin/tn3270-gui.mjs"
  },
  "files": ["app", "bin", "README.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/athornton/tn3270.git",
    "directory": "packages/gui"
  },
  "homepage": "https://github.com/athornton/tn3270#readme",
  "engines": { "node": ">=22" },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@tn3270/canvas": "0.1.0",
    "@tn3270/core": "0.1.0",
    "@tn3270/frontend": "0.1.0",
    "@tn3270/node-files": "0.1.0",
    "electron": "44.10.2"
  },
  "scripts": {
    "build": "tsc --build"
  }
}
